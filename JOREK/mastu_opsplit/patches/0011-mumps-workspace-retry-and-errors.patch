       mmss%mumps_par%A_loc   => a_mat%val
@@ -128,7 +132,18 @@
     endif
       
     mmss%mumps_par%JOB = 2                                   ! factorisation
-    call DMUMPS(mmss%mumps_par)
+    ! MUMPS 5.7.3 permits JOB=2 again after enlarging workspace for -8/-9.
