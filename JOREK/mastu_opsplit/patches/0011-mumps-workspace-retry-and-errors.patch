   end subroutine mumps_solve_multiple
+
+  subroutine mumps_check(mmss, phase)
+    use mpi_mod
+    use iso_fortran_env, only: error_unit
+    implicit none
+    type(type_MUMPS_SOLVER) :: mmss
+    character(len=*), intent(in) :: phase
+    integer :: my_id, ierr
+
+    if (mmss%mumps_par%infog(1) >= 0) return
+    call MPI_COMM_RANK(mmss%comm, my_id, ierr)
+    if (my_id == 0) then
+      write(error_unit,*) 'MUMPS failure during ', phase, ': INFOG(1:2)=', mmss%mumps_par%infog(1:2)
+      flush(error_unit)
+    endif
+    ! Equilibrium can use COMM_SELF while other world ranks wait for its result.
+    call MPI_ABORT(MPI_COMM_WORLD, 1, ierr)
+    error stop 1
+  end subroutine mumps_check
 
   subroutine mumps_finalize(mmss)
     implicit none
