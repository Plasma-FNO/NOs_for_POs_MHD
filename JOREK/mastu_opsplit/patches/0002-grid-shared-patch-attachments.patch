+! MAST-U OpsSplit addition; this JOREK derivative remains LGPL-3.0-or-later.
+pure subroutine opsplit_share_patch_attachment(old_r, old_z, new_r, new_z, n, counts, r, z)
+  implicit none
+  integer, intent(in) :: n, counts(n)
+  real*8, intent(in) :: old_r, old_z, new_r, new_z
+  real*8, intent(inout) :: r(n), z(n)
+  integer :: i
+  do i=1,n
+    ! Only identical interior aliases are shared; single-point wall endpoints stay fixed.
+    if (counts(i) > 1 .and. r(i) == old_r .and. z(i) == old_z) then
+      r(i) = new_r
+      z(i) = new_z
+    endif
+  enddo
+end subroutine opsplit_share_patch_attachment
