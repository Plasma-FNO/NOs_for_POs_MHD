+! MAST-U OpsSplit study addition; JOREK file remains LGPL-3.0-or-later.
+! The 4-vector is (value, d/ds, d/dt, d2/dsdt), not four point values.
+subroutine opsplit_perturb_node(r, z, psi, psi_axis, psi_bnd, center, width, taper, amplitude, rho, temp)
+  implicit none
+  real*8, intent(in) :: r(4), z(4), psi(4), psi_axis, psi_bnd, center(2), width(2), taper(2), amplitude(2)
+  real*8, intent(inout) :: rho(4), temp(4)
+  real*8 :: xr(4), xz(4), radius2(4), psin(4), gauss(4), shape(4), factor(4), unit(4)
+  unit = (/ 1.d0, 0.d0, 0.d0, 0.d0 /)
+  xr = (r - center(1)*unit) / width(1)
+  xz = (z - center(2)*unit) / width(2)
+  radius2 = multiply(xr,xr) + multiply(xz,xz)
+  psin = (psi - psi_axis*unit) / (psi_bnd - psi_axis)
+  gauss = compose(radius2, exp(-0.5d0*radius2(1)), &
+                  -0.5d0*exp(-0.5d0*radius2(1)), 0.25d0*exp(-0.5d0*radius2(1)))
+  ! Compact support ends at four widths; flux taper vanishes strictly inside separatrix.
+  shape = multiply(multiply(gauss, cutoff(radius2,9.d0,16.d0)), cutoff(psin,taper(1),taper(2)))
+  factor = unit + amplitude(1)*shape
+  rho = multiply(rho, factor)
+  factor = unit + amplitude(2)*shape
+  temp = multiply(temp, factor)
+contains
+  pure function multiply(a,b) result(c)
+    real*8, intent(in) :: a(4),b(4)
+    real*8 :: c(4)
+    c(1) = a(1)*b(1)
+    c(2) = a(2)*b(1) + a(1)*b(2)
+    c(3) = a(3)*b(1) + a(1)*b(3)
+    c(4) = a(4)*b(1) + a(2)*b(3) + a(3)*b(2) + a(1)*b(4)
+  end function multiply
+  pure function compose(x,f,df,ddf) result(y)
+    real*8, intent(in) :: x(4),f,df,ddf
+    real*8 :: y(4)
+    y = (/ f, df*x(2), df*x(3), df*x(4)+ddf*x(2)*x(3) /)
+  end function compose
+  pure function cutoff(x,a,b) result(y)
+    real*8, intent(in) :: x(4),a,b
+    real*8 :: y(4),v,f,df,ddf
+    if (x(1) <= a) then
+      y = (/1.d0,0.d0,0.d0,0.d0/)
+    else if (x(1) >= b) then
+      y = 0.d0
+    else
+      v = (x(1)-a)/(b-a)
+      f = (1.d0-v)**3 * (1.d0+3.d0*v+6.d0*v**2)
+      df = -30.d0*v**2*(1.d0-v)**2/(b-a)
+      ddf = -60.d0*v*(1.d0-v)*(1.d0-2.d0*v)/(b-a)**2
+      y = compose(x,f,df,ddf)
+    endif
+  end function cutoff
+end subroutine opsplit_perturb_node
