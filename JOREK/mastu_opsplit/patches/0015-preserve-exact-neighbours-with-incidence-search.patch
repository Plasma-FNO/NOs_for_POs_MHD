   write(*,*)'----------------------------------------------------------'
   
+  ! Only elements incident to the first endpoint can share an edge.
+  ! Descending insertion preserves the original ascending j_elm search order,
+  ! including duplicate vertices and non-manifold first-match behavior.
+  first_node = 0
+  last_node = 0
+  do i_elm = 1, element_list%n_elements
+    first_node = min(first_node, minval(element_list%element(i_elm)%vertex))
+    last_node = max(last_node, maxval(element_list%element(i_elm)%vertex))
+  enddo
+  allocate(head(first_node:last_node), next_entry(4*element_list%n_elements), &
+           incident_element(4*element_list%n_elements))
+  head = 0
+  slot = 0
+  do j_elm = element_list%n_elements, 1, -1
+    do iv = 1, n_vertex_max
+      i_node1 = element_list%element(j_elm)%vertex(iv)
+      slot = slot + 1
+      incident_element(slot) = j_elm
+      next_entry(slot) = head(i_node1)
+      head(i_node1) = slot
+    enddo
+  enddo
+
   ! --- Loop on each element
